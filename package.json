{
  "name": "@ahmartecnologias/ahmardesign",
  "version": "1.1.0",
  "description": "AHMAR Design - lightweight vanilla CSS component library inspired by Daisy UI. Pure CSS, no framework, 10 themes.",
  "main": "src/js/ahmardesign.js",
  "style": "src/css/ahmardesign.css",
  "exports": {
    ".": {
      "style": "./src/css/ahmardesign.css",
      "default": "./src/js/ahmardesign.js"
    },
    "./ahmardesign.css": "./src/css/ahmardesign.css",
    "./ahmardesign.js": "./src/js/ahmardesign.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salomaos/ahmardesign.git"
  },
  "bugs": {
    "url": "https://github.com/salomaos/ahmardesign/issues"
  },
  "homepage": "https://github.com/salomaos/ahmardesign#readme",
  "sideEffects": true,
  "files": [
    "src/css/ahmardesign.css",
    "src/js/ahmardesign.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && vite",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "css-framework",
    "vanilla-css",
    "ui-library",
    "design-system",
    "components",
    "utilities",
    "themes",
    "no-dependencies",
    "daisyui",
    "tailwind"
  ],
  "author": "Salomão",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
